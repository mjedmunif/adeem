### ==========================================
### Adeem API — Complete Test Suite
### ==========================================
### الاستخدام:
### 1. حط الملف بمجلد داخل المشروع (مثلاً http/)
### 2. شغل السيرفر أول
### 3. سو ملف http-client.env.json بجنبه (مثال بالأسفل) لتفعيل {{token}} تلقائياً
### 4. شغل الطلبات بالترتيب من فوق لتحت — كل مرحلة تعتمد على اللي قبلها
### ==========================================


### ==================== 1. AUTH & REGISTRATION ====================

### 1.1 Register Patient
POST {{baseUrl}}/users/register
Content-Type: application/json

{
  "email": "patient@test.com",
  "password": "12345678",
  "fullName": "Patient Test",
  "phoneNumber": "0512345678"
}

### 1.2 Register Doctor (status starts as PENDING)
POST {{baseUrl}}/doctors/register
Content-Type: application/json

{
  "email": "doctor@test.com",
  "password": "12345678",
  "fullName": "Doctor Test",
  "phoneNumber": "0512345679",
  "specialty": "Dermatology",
  "pricePerSession": 150,
  "licenseNumber": "LIC12345",
  "bio": "Experienced dermatologist"
}

### 1.3 Login as Patient
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "patient@test.com",
  "password": "12345678"
}

> {%
    client.global.set("token", response.body.token);
%}

### 1.4 Login as Doctor
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "doctor@test.com",
  "password": "12345678"
}

> {%
    client.global.set("doctorToken", response.body.token);
%}

###
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "admin@adeem.sa",
  "password": "Admin@12345"
}

### ==================== 2. USERS ====================

### 2.1 Get My Profile (Patient)
GET {{baseUrl}}/users/me
Authorization: Bearer {{token}}

### 2.2 Update My Profile
PUT {{baseUrl}}/users/me
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "fullName": "Patient Updated Name",
  "phoneNumber": "0599999999"
}

### 2.3 Access protected endpoint WITHOUT token -> يفترض 401
GET {{baseUrl}}/users/me

### 2.4 Patient tries admin-only endpoint -> يفترض 403
GET {{baseUrl}}/users
Authorization: Bearer {{token}}


### ==================== 3. DOCTORS ====================

### 3.1 Get Verified Doctors (Public, no token)
GET {{baseUrl}}/doctors/verified

### 3.2 Get My Doctor Profile
GET {{baseUrl}}/doctors/me
Authorization: Bearer {{doctorToken}}

### 3.3 Get Pending Doctors (Admin only)
GET {{baseUrl}}/doctors/pending
Authorization: Bearer {{token}}

### 3.4 Approve Doctor (Admin only)
### غيّر {id} برقم بروفايل الطبيب الفعلي
PUT {{baseUrl}}/doctors/1/verification
Authorization: Bearer eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiJhZG1pbkBhZGVlbS5zYSIsInVzZXJJZCI6Niwicm9sZSI6IkFETUlOIiwiaWF0IjoxNzg0ODk5NTAxLCJleHAiOjE3ODQ5ODU5MDF9.adHsjgLpmKwkOoCzxSsFBJ3E_p-cakfRwJ-pkUKRdnI
Content-Type: application/json

{
  "status": "VERIFIED"
}

### 3.5 Get Verified Doctors مرة ثانية بعد التوثيق
GET {{baseUrl}}/doctors/verified


### ==================== 4. DOCTOR AVAILABILITY ====================

### 4.1 Doctor Adds Availability
POST {{baseUrl}}/availability
Authorization: Bearer {{doctorToken}}
Content-Type: application/json

{
  "dayOfWeek": "SUNDAY",
  "startTime": "09:00:00",
  "endTime": "17:00:00"
}

### 4.2 Get My Availability (Doctor)
GET {{baseUrl}}/availability/me
Authorization: Bearer {{doctorToken}}

### 4.3 Get a Specific Doctor's Availability (Public)
GET {{baseUrl}}/availability/doctor/1


### ==================== 5. APPOINTMENTS — CHAT FLOW ====================

### 5.1 Get Available Slots (Public)
GET {{baseUrl}}/appointments/available-slots?doctorId=1&date=2026-07-26

### 5.2 Book Appointment — CHAT type
POST {{baseUrl}}/appointments
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "doctorId": 1,
  "appointmentDate": "2026-07-26T09:00:00",
  "consultationType": "CHAT"
}

> {%
    client.global.set("appointmentId", response.body.id);
%}

### 5.3 Get My Appointments (Patient)
GET {{baseUrl}}/appointments/my-appointments
Authorization: Bearer {{token}}

### 5.4 Get My Appointments (Doctor)
GET {{baseUrl}}/appointments/doctor-appointments
Authorization: Bearer {{doctorToken}}


### ==================== 6. PAYMENT — CHAT APPOINTMENT ====================

### 6.1 Initiate Payment
POST {{baseUrl}}/payments/initiate
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "appointmentId": 1
}

> {%
    client.global.set("transactionRef", response.body.transactionReference);
%}

### 6.2 Confirm Payment
POST {{baseUrl}}/payments/confirm
Content-Type: application/json

{
  "transactionReference": "MOCK-99323ECC-3C4"
}

### 6.3 تأكد الموعد صار CONFIRMED
GET {{baseUrl}}/appointments/my-appointments
Authorization: Bearer {{token}}


### ==================== 7. CHAT MESSAGING ====================

### 7.1 Send Message
POST {{baseUrl}}/messages
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "appointmentId": {{appointmentId}},
  "content": "مرحباً دكتور، عندي استفسار"
}

### 7.2 Doctor replies
POST {{baseUrl}}/messages
Authorization: Bearer {{doctorToken}}
Content-Type: application/json

{
  "appointmentId": {{appointmentId}},
  "content": "تفضل، وش المشكلة؟"
}

### 7.3 Get Conversation History
GET {{baseUrl}}/messages/{{appointmentId}}
Authorization: Bearer {{token}}


### ==================== 8. APPOINTMENTS — CALL FLOW (Zoom) ====================

### 8.1 Book Appointment — CALL type
POST {{baseUrl}}/appointments
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "doctorId": 1,
  "appointmentDate": "2026-07-26T11:00:00",
  "consultationType": "CALL"
}

> {%
    client.global.set("callAppointmentId", response.body.id);
%}

### 8.2 Initiate Payment for CALL appointment
POST {{baseUrl}}/payments/initiate
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "appointmentId": {{callAppointmentId}}
}

> {%
    client.global.set("transactionRef", response.body.transactionReference);
%}

### 8.3 Confirm Payment — هذا يفعّل Zoom تلقائياً
POST {{baseUrl}}/payments/confirm
Content-Type: application/json

{
  "transactionReference": "{{transactionRef}}"
}

### 8.4 تأكد meetingLink طلع رابط Zoom حقيقي
GET {{baseUrl}}/appointments/my-appointments
Authorization: Bearer {{token}}


### ==================== 9. CANCEL APPOINTMENT ====================

### 9.1 Cancel an appointment
PUT {{baseUrl}}/appointments/1/cancel
Authorization: Bearer {{token}}


### ==================== 10. CHATBOT (وهج) — TEXT ====================

### 10.1 First message
POST {{baseUrl}}/chatbot/ask
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "content": "عندي طفح جلدي أحمر بالذراع من يومين"
}

> {%
    client.global.set("conversationId", response.body.conversationId);
%}

### 10.2 استمرار نفس المحادثة
POST {{baseUrl}}/chatbot/ask
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "content": "فيه حكة بسيطة، وما جربت أي علاج",
  "conversationId": {{conversationId}}
}

### 10.3 رسالة بالإنجليزي
POST {{baseUrl}}/chatbot/ask
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "content": "I have a red rash on my arm"
}

### 10.4 سيناريو طارئ
POST {{baseUrl}}/chatbot/ask
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "content": "عندي صعوبة تنفس وتورم شديد بالوجه"
}

### 10.5 Get Chatbot Conversation History
GET {{baseUrl}}/chatbot/{{conversationId}}
Authorization: Bearer {{token}}


### ==================== 11. CHATBOT — IMAGE UPLOAD ====================
### استخدم Postman لهذا الطلب (رفع ملفات أسهل فيه)

### 11.1 Ask with image attached
POST {{baseUrl}}/chatbot/ask-with-image
Authorization: Bearer {{token}}
Content-Type: multipart/form-data; boundary=WebAppBoundary

--WebAppBoundary
Content-Disposition: form-data; name="content"

هذا تحليل الدم الأخير، وش رأيك فيه؟
--WebAppBoundary
Content-Disposition: form-data; name="image"; filename="test-image.jpg"
Content-Type: image/jpeg

< ./test-image.jpg
--WebAppBoundary--


### ==================== 12. NEGATIVE / SECURITY TESTS ====================

### 12.1 وصول بدون توكن -> 401
GET {{baseUrl}}/appointments/my-appointments

### 12.2 مريض يحاول يدفع لموعد مو موعده
POST {{baseUrl}}/payments/initiate
Authorization: Bearer {{doctorToken}}
Content-Type: application/json

{
  "appointmentId": {{appointmentId}}
}

### 12.3 مريض يحاول يوثق طبيب (admin-only) -> 403
PUT {{baseUrl}}/doctors/1/verification
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "status": "VERIFIED"
}

### 12.4 محاولة حجز موعد بوقت خارج دوام الطبيب
POST {{baseUrl}}/appointments
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "doctorId": 1,
  "appointmentDate": "2026-07-26T22:00:00",
  "consultationType": "CHAT"
}

### 12.5 محاولة حجز موعد بنفس الوقت مرتين -> 409
POST {{baseUrl}}/appointments
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "doctorId": 1,
  "appointmentDate": "2026-07-26T09:00:00",
  "consultationType": "CHAT"
}